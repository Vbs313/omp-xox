{
  "name": "omp-xox",
  "version": "3.1.0",
  "description": "OMP extension pack: 9 modules — safety gate, path guard, exec sandbox, workspace map, plan mode, test runner, auto repair, DAG scheduler, verification gate",
  "type": "module",
  "omp": {
    "name": "omp-xox",
    "description": "9-module extension pack — only what OMP doesn't provide natively",
    "extensions": [
      "./extensions/safety-gate/index.ts",
      "./extensions/path-guard/index.ts",
      "./extensions/exec-sandbox/index.ts",
      "./extensions/workspace-map/index.ts",
      "./extensions/plan-mode/index.ts",
      "./extensions/dev-tools/index.ts",
      "./extensions/auto-repair/index.ts",
      "./extensions/dag-scheduler/index.ts",
      "./extensions/verification-gate/index.ts"
    ],
    "tools": "./extensions",
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "keywords": [
    "omp",
    "agent",
    "safety",
    "sandbox",
    "verification",
    "planning",
    "orchestration",
    "repair",
    "multi-agent"
  ],
  "author": "Vbs313",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vbs313/omp-xox.git"
  },
  "homepage": "https://github.com/Vbs313/omp-xox",
  "bugs": {
    "url": "https://github.com/Vbs313/omp-xox/issues"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "*"
  }
}
