  "type": "module",
  "omp": {
    "name": "omp-xox",
    "description": "9-extension pack for multi-agent orchestration and dev tooling",
    "extensions": [
      "./extensions/dag-scheduler/index.ts",
      "./extensions/dev-tools/index.ts",
      "./extensions/safety-gate/index.ts",
      "./extensions/context-guard/index.ts",
      "./extensions/fallback-pipeline/index.ts",
      "./extensions/verification-gate/index.ts",
      "./extensions/task-spawner/index.ts",
      "./extensions/auto-delegate/index.ts",
      "./extensions/knowledge-writer/index.ts"
    ],
    "tools": "./extensions",
